// A frame written with every spelling the hex reader accepts, on
// purpose: bare hex with no 0x prefix, lower and upper case digits,
// '_' digit separators, a trailing comment on a data line, and a blank
// line in the middle of the image. All four lines must parse to the
// same 4 pixels.
//
// Dimensions: 4x3

0x0000_0000 0x0000_0040 0x0000_0080 0x0000_00FF   // R ramps, 0x00 alpha
00000000 00000040 00000080 000000ff              # same line, no prefix

0X0000_0000 0x0000_0040 0X0000_0080 0x0000_00Ff
